{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**,templates/**,static/**,data/**",
      "excludeFiles": "{.packages/**,reports/**,private_data/**,backups/**,tests/**,**/__pycache__/**,*.log,*.pid}"
    }
  }
}
