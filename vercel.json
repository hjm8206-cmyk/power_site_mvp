{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "power_site_mvp/app/**,power_site_mvp/templates/**,power_site_mvp/static/**,power_site_mvp/data/**",
      "excludeFiles": "{power_site_mvp/.packages/**,power_site_mvp/reports/**,power_site_mvp/private_data/**,power_site_mvp/backups/**,power_site_mvp/tests/**,**/__pycache__/**,*.log,*.pid}"
    }
  }
}
